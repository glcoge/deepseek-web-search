{
  "manifest_version": 2,
  "id": "glcoge.deepseek-web-search",
  "version": "1.0.0",
  "name": "DeepSeek 联网搜索",
  "description": "调用 DeepSeek Search / Fetch API，为模型提供按需联网搜索与网页抓取工具，替代模型自带联网搜索。",
  "author": {
    "name": "glcoge",
    "url": "https://github.com/glcoge"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/glcoge/deepseek-web-search",
    "homepage": "https://github.com/glcoge/deepseek-web-search",
    "documentation": "https://github.com/glcoge/deepseek-web-search/blob/main/README.md",
    "issues": "https://github.com/glcoge/deepseek-web-search/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27,<1"
    }
  ],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "search"
    }
  },
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
